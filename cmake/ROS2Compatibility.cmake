# Compatibility helpers for newer ROS 2 distributions (Jazzy, Kilted, Lyrical, etc.)
if("$ENV{ROS_DISTRO}" STREQUAL "lyrical")
    set(CMAKE_CXX_STANDARD 20)
    set(CMAKE_CXX_STANDARD_REQUIRED ON)
    set(CMAKE_CXX_EXTENSIONS OFF)
elseif("$ENV{ROS_DISTRO}" STREQUAL "jazzy" OR "$ENV{ROS_DISTRO}" STREQUAL "kilted")
    if(NOT CMAKE_CXX_STANDARD OR CMAKE_CXX_STANDARD LESS 17)
        set(CMAKE_CXX_STANDARD 17)
    endif()
    set(CMAKE_CXX_STANDARD_REQUIRED ON)
    set(CMAKE_CXX_EXTENSIONS OFF)
endif()

# In ROS 2 Lyrical and newer, ament_target_dependencies() was removed from ament_cmake.
# Provide a compatibility shim that links exported CMake targets and include dirs.
if(NOT COMMAND ament_target_dependencies)
    function(ament_target_dependencies target)
        if(NOT TARGET ${target})
            message(FATAL_ERROR "ament_target_dependencies() the first argument must be a valid target name")
        endif()
        if(${ARGC} GREATER 1)
            cmake_parse_arguments(ARG "PUBLIC;INTERFACE;PRIVATE" "SYSTEM" "" ${ARGN})
            set(scope "")
            if(ARG_PUBLIC)
                set(scope PUBLIC)
            elseif(ARG_INTERFACE)
                set(scope INTERFACE)
            elseif(ARG_PRIVATE)
                set(scope PRIVATE)
            endif()
            foreach(dep ${ARG_UNPARSED_ARGUMENTS})
                if( DEFINED ${dep}_TARGETS AND NOT "${${dep}_TARGETS}" STREQUAL "" )
                    target_link_libraries(${target} ${scope} ${${dep}_TARGETS})
                else()
                    if(DEFINED ${dep}_INCLUDE_DIRS)
                        target_include_directories(${target} ${scope} ${${dep}_INCLUDE_DIRS})
                    endif()
                    if(DEFINED ${dep}_DEFINITIONS)
                        target_compile_definitions(${target} ${scope} ${${dep}_DEFINITIONS})
                    endif()
                    if(DEFINED ${dep}_LIBRARIES)
                        target_link_libraries(${target} ${scope} ${${dep}_LIBRARIES})
                    endif()
                endif()
            endforeach()
        endif()
    endfunction()
endif()
